<UserControl x:Class="UMF流量计.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <hc:ScrollViewer>
        <StackPanel Margin="16">
            <TextBlock Text="实时监控" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>

            <!-- 瞬时流量大卡片 -->
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="24"
                    Effect="{DynamicResource EffectShadow4}" Margin="0,0,0,16">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="瞬时流量" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DashboardVm.FlowRate, StringFormat=F2}" FontSize="56" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="m³/h" FontSize="20" Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                    </StackPanel>
                    <hc:CircleProgressBar Value="{Binding DashboardVm.FlowRate}" Maximum="2000" Width="200" Height="200"
                                          Margin="0,16,0,0" FontSize="24" ShowText="True"/>
                </StackPanel>
            </Border>

            <!-- 三栏数据卡片 -->
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <!-- 温度 -->
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0"
                        Effect="{DynamicResource EffectShadow2}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="介质温度" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DashboardVm.Temperature, StringFormat=F1}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="°C" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 压力 -->
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="16" Margin="4,0,4,0"
                        Effect="{DynamicResource EffectShadow2}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="介质压力" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DashboardVm.Pressure, StringFormat=F2}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="MPa" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 累积流量 -->
                <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,0"
                        Effect="{DynamicResource EffectShadow2}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="累积流量" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DashboardVm.CumulativeFlow, StringFormat=N0}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="m³" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 连接状态 -->
            <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="16"
                    Effect="{DynamicResource EffectShadow2}">
                <StackPanel>
                    <TextBlock Text="连接状态" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Red"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DashboardVm.IsOnline}" Value="True">
                                            <Setter Property="Fill" Value="LimeGreen"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="离线"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DashboardVm.IsOnline}" Value="True">
                                            <Setter Property="Text" Value="在线"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="{Binding DashboardVm.LastUpdateTime, StringFormat='最后更新: {0:yyyy-MM-dd HH:mm:ss}'}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </hc:ScrollViewer>
</UserControl>
