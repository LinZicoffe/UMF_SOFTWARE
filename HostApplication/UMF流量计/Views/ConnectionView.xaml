<UserControl x:Class="UMF流量计.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <hc:ScrollViewer>
        <StackPanel Margin="24" Width="500" HorizontalAlignment="Center">
            <TextBlock Text="连接设置" FontSize="24" FontWeight="Bold" Margin="0,0,0,24"/>

            <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="24" Margin="0,0,0,16"
                    Effect="{DynamicResource EffectShadow2}">
                <StackPanel>
                    <TextBlock Text="串口配置" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="串口号:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ConnectionVm.AvailablePorts}" SelectedItem="{Binding ConnectionVm.SelectedPort}"
                                  hc:InfoElement.Placeholder="选择串口"/>
                        <Button Grid.Column="2" Content="刷新" Margin="8,0,0,0" Command="{Binding ConnectionVm.RefreshPortsCommand}"
                                Style="{StaticResource ButtonDefault}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="波特率:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ConnectionVm.BaudRates}" SelectedItem="{Binding ConnectionVm.SelectedBaudRate}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="从站地址:" VerticalAlignment="Center"/>
                        <hc:NumericUpDown Grid.Column="1" Value="{Binding ConnectionVm.SlaveAddress}" Minimum="1" Maximum="247"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="采集间隔:" VerticalAlignment="Center"/>
                        <hc:NumericUpDown Grid.Column="1" Value="{Binding ConnectionVm.PollInterval}" Minimum="500" Maximum="5000" Increment="100"/>
                    </Grid>
                </StackPanel>
            </Border>

            <hc:ButtonGroup HorizontalAlignment="Center">
                <Button Content="连接" Command="{Binding ConnectionVm.ConnectCommand}" Style="{StaticResource ButtonPrimary}"
                        Width="120" Height="40"/>
                <Button Content="断开" Command="{Binding ConnectionVm.DisconnectCommand}" Style="{StaticResource ButtonDanger}"
                        Width="120" Height="40"/>
            </hc:ButtonGroup>

            <Border Background="{DynamicResource RegionBrush}" CornerRadius="8" Padding="16" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="通信参数说明" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="协议: Modbus RTU (RS-485)" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                    <TextBlock Text="数据位: 8 | 校验: None | 停止位: 1" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                    <TextBlock Text="超时: 1000ms" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </hc:ScrollViewer>
</UserControl>
